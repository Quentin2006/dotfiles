        {
          "id": "omarchy.tray"
        },
        {
          "id": "io.github.thisisgm.omapods"
        },
        {
          "id": "omarchy.audio"
        },
        {
          "id": "omarchy.bluetooth"
        },
        {
          "id": "omarchy.tailscale"
        },
        {
          "id": "omarchy.network"
        },
        {
          "id": "omarchy.power"
        }
      ]
    },
    "position": "top",
